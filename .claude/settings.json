{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the docs were read first"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs.mjs\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-docs-update.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/obsidian/hate-watch/.tools/sync.sh\"; [ -x \"$f\" ] && \"$f\"; true",
            "async": true,
            "timeout": 120
          },
          {
            "type": "command",
            "command": "f=\"$HOME/hate watch/server/data/recordings/recorders.py\"; [ -f \"$f\" ] && /usr/bin/python3 \"$f\" --restart; true",
            "timeout": 60,
            "statusMessage": "Checking the recorders"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/obsidian/hate-watch/.tools/sync.sh\"; [ -x \"$f\" ] && \"$f\" --hook; true",
            "async": true,
            "timeout": 120
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-vault-log.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
