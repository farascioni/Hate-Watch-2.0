{
  // hatewatch.dev: the marketing page at "/" (public/about/index.html) and the web version of the app at
  // "/app". `npx expo export --platform web` writes ./dist (with baseUrl /app, set by app.config.js), Cloudflare
  // serves it. worker.js runs only for the paths below: it serves "/" the marketing page, 301s "/about" to "/",
  // serves /app/... the app shell (so Expo Router's client routes, /app/game/..., work on reload) and its files
  // with the /app prefix stripped, and 301s the app's old root addresses (/game/..., /a/..., /scores ...) to /app/...
  // Every other path is a plain file in ./dist or a real 404 (public/404.html).
  // A NEW ROUTE FILE IN src/app/ NEEDS NOTHING HERE: it lives under /app/*. The old root list below
  // exists only for the redirects; a new top-level page is a file in public/.
  "name": "hate-watch-2-0",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/about",
      "/about/",
      "/app",
      "/app/*",
      "/following",
      "/scores",
      "/search",
      "/settings",
      "/guide",
      "/leaderboard",
      "/a/*",
      "/alert/*",
      "/alerts/*",
      "/f1/*",
      "/game/*",
      "/stats/*",
      "/target/*",
      "/ufc/*"
    ]
  }
}
